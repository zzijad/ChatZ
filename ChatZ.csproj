<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\chatz.ico</ApplicationIcon>
    <AssemblyName>ChatZ</AssemblyName>
    <RootNamespace>ChatZ</RootNamespace>
    <Version>1.2.0</Version>
    <Product>ChatZ</Product>
    <Description>WhatsApp, Telegram i Viber u jednom prozoru</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\chatz.ico" />
  </ItemGroup>

</Project>
