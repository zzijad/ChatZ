<Window x:Class="ChatZ.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIN zaštita"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" FontSize="13"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>

        <StackPanel x:Name="CurrentPanel">
            <TextBlock Text="Trenutni PIN / lozinka" FontSize="13" Margin="0,0,0,4"/>
            <PasswordBox x:Name="CurrentBox" Height="32" Padding="6,4" FontSize="14" Margin="0,0,0,12"/>
        </StackPanel>

        <TextBlock x:Name="NewLabel" Text="Novi PIN / lozinka (najmanje 4 znaka)" FontSize="13" Margin="0,0,0,4"/>
        <PasswordBox x:Name="NewBox" Height="32" Padding="6,4" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock Text="Ponovi novi PIN / lozinku" FontSize="13" Margin="0,0,0,4"/>
        <PasswordBox x:Name="RepeatBox" Height="32" Padding="6,4" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock Text="Automatsko zaključavanje posle neaktivnosti" FontSize="13" Margin="0,0,0,4"/>
        <ComboBox x:Name="AutoLockBox" Height="30" Margin="0,0,0,6">
            <ComboBoxItem Content="Isključeno" Tag="0"/>
            <ComboBoxItem Content="1 minut" Tag="1"/>
            <ComboBoxItem Content="5 minuta" Tag="5"/>
            <ComboBoxItem Content="15 minuta" Tag="15"/>
            <ComboBoxItem Content="30 minuta" Tag="30"/>
            <ComboBoxItem Content="60 minuta" Tag="60"/>
        </ComboBox>
        <TextBlock Text="ChatZ se zaključava i kad ga zatvoriš na X (ode u tray). Minimizovanje ne zaključava."
                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" FontSize="13" TextWrapping="Wrap"
                   Margin="0,0,0,10" Visibility="Collapsed"/>

        <DockPanel LastChildFill="False">
            <Button x:Name="DisableButton" DockPanel.Dock="Left" Content="Isključi zaštitu"
                    Padding="12,6" Click="Disable_Click" Visibility="Collapsed"/>
            <Button DockPanel.Dock="Right" Content="Otkaži" Padding="14,6" Margin="8,0,0,0"
                    IsCancel="True"/>
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Sačuvaj" Padding="14,6"
                    IsDefault="True" Click="Save_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
